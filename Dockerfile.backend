FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/workspace/backend

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg libglib2.0-0 libgl1 libgomp1 curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY backend/requirements.txt /workspace/backend/requirements.txt
COPY backend/requirements-postgres.txt /workspace/backend/requirements-postgres.txt
RUN pip install --upgrade pip && pip install -r /workspace/backend/requirements.txt && \
    pip install -r /workspace/backend/requirements-postgres.txt

COPY backend /workspace/backend
COPY config /workspace/config
COPY scripts /workspace/scripts
RUN mkdir -p /workspace/models /workspace/runtime
WORKDIR /workspace/models
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
