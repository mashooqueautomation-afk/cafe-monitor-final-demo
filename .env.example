# ============================================================================
#  AUTONIQ Cafe Monitor - settings.   Copy this file to ".env" and edit.
#  NEVER commit/share ".env" (it can contain camera passwords).
# ============================================================================

# demo = recorded clips from data/client_footage | live = real NVR/DVR cameras (RTSP, no fallback to recordings)
DEFAULT_MODE=demo

# ---- Speed / accuracy (small laptop: Core i3, 2 cores) ----------------------
# YOLO_IMGSZ: CPU-friendly starting point for an older dual-core laptop. Increase only after benchmarking.
YOLO_MODEL=/workspace/models/yolov8n.pt
YOLO_BACKEND=auto
YOLO_IMGSZ=640
YOLO_CONFIDENCE=0.20
PERSON_DETECTION_IMGSZ=640
PERSON_DETECTION_CONFIDENCE=0.12
PERSON_TILED_INFERENCE=true
MAX_RESULT_FRAME_AGE_MS=5000
YOLO_DEVICE=cpu
TORCH_NUM_THREADS=1
TORCH_INTEROP_THREADS=1
OPENCV_NUM_THREADS=1
# AI checks/sec per camera; all inference shares one CPU model lock. These defaults favour playback responsiveness.
ANALYTICS_FPS=0.2
ENTRANCE_FPS=0.5
DEMO_PLAYBACK_FPS=4
DEMO_USE_PROXIES=true
DEMO_PROXY_FPS=4
DEMO_PROXY_WIDTH=640
DEMO_PROXY_DIR=/workspace/runtime/demo_proxy
# Focus mode: one selected camera gets more frequent inference; keep only one camera selected on this CPU.
FOCUS_MAX_CAMERAS=1
FOCUS_ENTRANCE_FPS=2
FOCUS_ANALYTICS_FPS=0.2
# Dashboard tile JPEG rate (lower reduces encoding and browser/network work)
DISPLAY_FPS=1.5
JPEG_QUALITY=50
MAX_STREAM_WIDTH=640

# Docker memory limits
CAFE_MEMORY_LIMIT=3g
DIAG_MEMORY_LIMIT=768m

# ---- Model weights ----------------------------------------------------------
# Weights live in the Docker volume "yolo_models" (downloaded once, then reused).
YOLO_AUTO_DOWNLOAD=true

# ---- Ports (localhost only) -------------------------------------------------
# DASHBOARD_PORT=8080
# BACKEND_PORT=8000
# DIAG_PORT=8090

# ---- LIVE MODE sources (SECRET) --------------------------------------------
# rtsp://USER:PASS@IP:554/<sub-stream path>   (use the SUB stream; get the exact path from cafe IT)
# http://PHONE_IP:8080/video                  (phone "IP camera" app, for testing)
# webcam:0                                    (laptop webcam, for testing)
CAMERA_01_RTSP=
CAMERA_02_RTSP=
CAMERA_03_RTSP=
CAMERA_04_RTSP=
CAMERA_05_RTSP=
CAMERA_06_RTSP=
CAMERA_07_RTSP=
CAMERA_08_RTSP=
LIVE_RECONNECT_MIN_SECONDS=2
LIVE_RECONNECT_MAX_SECONDS=30

# ---- Optional: override a demo clip path (otherwise config/cameras.yaml is used) ----
# DEMO_CAMERA_07_FILE=data/client_footage/camera_07_entrance/sample.mp4
# DEMO_CAMERA_08_FILE=data/client_footage/camera_08_unmapped/sample.mp4
